# Preenchido automaticamente pela Vercel quando você conecta um banco
# Vercel Postgres (Neon) ao projeto (vercel env pull .env.local).
# Para rodar localmente, use `vercel link` + `vercel env pull .env.local`
# em vez de preencher este arquivo à mão.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_PRISMA_URL=

# Preenchido automaticamente quando você cria um Blob store na Vercel
# e conecta ao projeto. Necessário só para o upload de favicon.
BLOB_READ_WRITE_TOKEN=

# Segredo usado para assinar o cookie de sessão do login.
# Gere um valor aleatório (ex: `openssl rand -hex 32`) e defina como
# variável de ambiente no projeto na Vercel (Settings > Environment Variables).
SESSION_SECRET=

# Domínio canônico usado para montar/copiar o link público das páginas
# (ex: https://seudominio.com.br, sem barra no final). Se não definido,
# cai no window.location.origin — o que funciona, mas mostra qualquer
# domínio (inclusive o *.vercel.app) usado pra acessar o admin no momento.
# Precisa do prefixo VITE_ pra chegar no front-end.
VITE_PUBLIC_URL=
